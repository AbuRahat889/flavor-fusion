NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flavor_fusion?schema=public

# MongoDB
MONGO_URI=mongodb://localhost:27017/flavor_fusion

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Default Admin (seeded automatically on first boot)
DEFAULT_ADMIN_EMAIL=admin@gmail.com
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_ADMIN_NAME=Super Admin
